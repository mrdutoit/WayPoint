{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth/:slug*", "destination": "/api/auth-router?slug=:slug*" },
    { "source": "/api/flags/:slug*", "destination": "/api/flags-router?slug=:slug*" },
    { "source": "/api/admin/:slug*", "destination": "/api/admin-router?slug=:slug*" },
    { "source": "/api/tenants/:slug*", "destination": "/api/tenants-router?slug=:slug*" },
    { "source": "/api/users/:slug*", "destination": "/api/users-router?slug=:slug*" },
    { "source": "/api/me/:slug*", "destination": "/api/me-router?slug=:slug*" },
    { "source": "/api/settings/:slug*", "destination": "/api/settings-router?slug=:slug*" },
    { "source": "/api/cycles/:slug*", "destination": "/api/cycles-router?slug=:slug*" },
    { "source": "/api/objectives/:slug*", "destination": "/api/objectives-router?slug=:slug*" },
    { "source": "/api/key-results/:slug*", "destination": "/api/key-results-router?slug=:slug*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
